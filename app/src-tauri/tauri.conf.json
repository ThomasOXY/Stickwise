{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RB-EXPORT",
  "version": "0.1.0",
  "identifier": "cz.thomasoxy.rbexport",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "sh scripts/fetch-uv.sh && sh scripts/fetch-models.sh && npm run dev",
    "beforeBuildCommand": "sh scripts/fetch-uv.sh && sh scripts/fetch-models.sh && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "RB-EXPORT",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "transparent": true,
        "theme": "Dark",
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["/Volumes/**", "$HOME/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "externalBin": ["binaries/uv"],
    "resources": {
      "../../sidecar/pyproject.toml": "sidecar/pyproject.toml",
      "../../sidecar/uv.lock": "sidecar/uv.lock",
      "../../sidecar/cue_detr.py": "sidecar/cue_detr.py",
      "../../sidecar/rekordbox_dump.py": "sidecar/rekordbox_dump.py",
      "models/mel_spectrogram.onnx": "models/mel_spectrogram.onnx",
      "models/beat_this.onnx": "models/beat_this.onnx"
    },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
