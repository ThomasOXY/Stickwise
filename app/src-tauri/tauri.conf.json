{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RB-EXPORT",
  "version": "0.1.0",
  "identifier": "cz.thomasoxy.rbexport",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "RB-EXPORT",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "transparent": true,
        "theme": "Dark",
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["/Volumes/**", "$HOME/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
